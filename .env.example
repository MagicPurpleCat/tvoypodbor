# ---------- Домены и адреса ----------
API_DOMAIN=api.example.com
APP_DOMAIN=app.example.com
PUBLIC_URL=https://api.example.com          # база для вебхуков Telegram и Platega
WEBAPP_URL=https://app.example.com          # адрес Mini App (он же CORS origin)
PORT=3000
NODE_ENV=production
RUN_JOBS=true                               # воркер уведомлений и планировщик в этом процессе

# ---------- Хранилища ----------
POSTGRES_PASSWORD=change_me_long_random
# локально (npm run dev); в docker-compose переопределяется
DATABASE_URL=postgres://tvoypodbor:change_me_long_random@localhost:5432/tvoypodbor
REDIS_URL=redis://localhost:6379

# ---------- Telegram ----------
BOT_TOKEN=                                  # от @BotFather
BOT_USERNAME=tvoypodbor_bot                 # без @
BOT_WEBHOOK_SECRET=                         # openssl rand -hex 32
WEBAPP_SHORT_NAME=app                       # short name из /newapp → t.me/<bot>/<short_name>
INIT_DATA_TTL_SEC=86400
SUPPORT_CHAT_ID=                            # id чата операторов (необязательно)

# ---------- Лимиты ----------
FREE_DAILY_LIMIT=5
TZ_OFFSET_HOURS=3                           # сутки лимита — по МСК

# ---------- Platega.io ----------
PLATEGA_BASE_URL=https://app.platega.io
PLATEGA_MERCHANT_ID=                        # UUID мерчанта из ЛК
PLATEGA_SECRET=                             # API-ключ из ЛК

# ---------- hh.ru ----------
HH_USER_AGENT=TvoyPodbor/1.0 (you@example.com)   # обязателен: название/версия (контакт)
HH_APP_TOKEN=                               # необязательно: токен приложения dev.hh.ru

# ---------- Генератор откликов ----------
LLM_PROVIDER=template                       # template — бесплатно, без ключей | openai_compat
LLM_BASE_URL=                               # https://openrouter.ai/api/v1 | https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=                                  # для OpenRouter — модель с суффиксом :free
